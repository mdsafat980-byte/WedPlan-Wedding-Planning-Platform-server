# ---------------------------------------------------------------------------
# WedPlan API - environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Public URL of this API (used for Better Auth callbacks and JWT issuer)
BETTER_AUTH_URL=http://localhost:5000

# Public URL of the Next.js client (CORS + Better Auth trusted origin)
CLIENT_URL=http://localhost:3000

# MongoDB (leave empty in development to use an in-memory database)
MONGODB_URI=

# Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (optional - the Google button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# ImgBB image hosting (optional - uploads fall back to local disk when unset)
IMGBB_API_KEY=

# Public base URL used to build local upload URLs
PUBLIC_SERVER_URL=http://localhost:5000

# Initial admin account (created by `npm run seed`)
ADMIN_NAME=WedPlan Admin
ADMIN_EMAIL=admin@wedplan.com
ADMIN_PASSWORD=Admin123

# Seed demo vendors/customers/services on first boot (development only)
AUTO_SEED=true
